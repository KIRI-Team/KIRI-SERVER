// 1. 앱 지표 (JVM, HTTP, DB 커넥션 풀 등 Micrometer 기본 지표)
prometheus.scrape "app" {
	targets = [{
		"__address__" = "127.0.0.1:8080",
		"job"         = "kiri-server",
		"instance"    = "kiri-" + sys.env("DEPLOY_ENV") + "-api",
	}]
	metrics_path = "/actuator/prometheus"

	scrape_interval = "60s"

	forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// 2. 서버 지표 (noed_exporter 내장판)
prometheus.exporter.unix "node" {
	procfs_path = "/host/proc"
	sysfs_path  = "/host/sys"
	rootfs_path = "/host/root"

	// 도커 overloay, tmpfs 등 의미 없는 파일시스템은 디스크 지표에서 제외
	filesystem {
		fs_types_exclude = "^(autofs|binfmt_misc|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|mqueue|nsfs|overlay|proc|pstore|securityfs|squashfs|sysfs|tmpfs|tracefs)$"
	}
}

// exporter가 붙이는 기본 job/instance 라벨 바꿈
discovery.relabel "node" {
	targets = prometheus.exporter.unix.node.targets

	rule {
		target_label = "job"
		replacement  = "integrations/node_exporter"
	}

	rule {
		target_label = "instance"
		replacement  = "kiri-" + sys.env("DEPLOY_ENV") + "-api"
	}
}

prometheus.scrape "node" {
	targets         = discovery.relabel.node.output
	scrape_interval = "60s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// 3. Grafana Cloud Prometheus로 전송
prometheus.remote_write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_PROM_URL")

		basic_auth {
			username = sys.env("GRAFANA_PROM_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}
	}

	external_labels = {
		env = sys.env("DEPLOY_ENV"),
	}
}

// 4. Grafana Cloud Loki로 전송
discovery.docker "app" {
	host = "unix:///var/run/docker.sock"

	filter {
		name   = "name"
		values = ["^/kiri-(server|nginx)$"]
	}
}

discovery.relabel "app_logs" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "app"
	}
}

loki.source.docker "app" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.app.targets
	relabel_rules = discovery.relabel.app_logs.rules
	forward_to    = [loki.process.app.receiver]
}

loki.process "app" {
	stage.json {
		expressions = {
			level   = "level",
			traceId = "traceId",
		}
	}

	stage.labels {
		values = {level = ""}
	}

	stage.structured_metadata {
		values = {traceId = ""}
	}

	forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_LOKI_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}
	}

	external_labels = {
		env = sys.env("DEPLOY_ENV"),
	}
}
